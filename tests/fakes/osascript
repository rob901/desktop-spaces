#!/usr/bin/env python3
"""Fake osascript: answers the Chrome tab-capture script only."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import fakelib  # noqa: E402

st = fakelib.load()
out = ""
for w in st["windows"]:
    if w["bundle"] == "com.google.Chrome":
        out += "\x1f".join([w.get("chrome_title", w["title"])] + w.get("urls", [])) + "\x1e"
print(out)
